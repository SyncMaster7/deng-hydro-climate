# deng-hydro-climate — .env.example
# Copy to .env and fill in real values. Never commit .env to Git.

# ---------------------------------------------------------------------------
# Analytics database (application data)
# ---------------------------------------------------------------------------
ANALYTICS_DB_USER=analytics
ANALYTICS_DB_PASSWORD=your_analytics_db_password
ANALYTICS_DB_NAME=hydro_climate_db

# ---------------------------------------------------------------------------
# Airflow metadata database (Airflow internals only)
# ---------------------------------------------------------------------------
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=your_airflow_db_password
AIRFLOW_DB_NAME=airflow_db

# ---------------------------------------------------------------------------
# Airflow security keys
# Generate FERNET_KEY with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Generate SECRET_KEY with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Generate JWT_SECRET with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# ---------------------------------------------------------------------------
AIRFLOW_FERNET_KEY=your_fernet_key
AIRFLOW_SECRET_KEY=your_secret_key
AIRFLOW_JWT_SECRET=your_jwt_secret

# ---------------------------------------------------------------------------
# Airflow admin user (created on first init)
# ---------------------------------------------------------------------------
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=your_airflow_admin_password
AIRFLOW_ADMIN_EMAIL=your_email@example.com

# ---------------------------------------------------------------------------
# Airflow UID — match your server user to avoid volume permission issues
# Find with: id -u
# ---------------------------------------------------------------------------
AIRFLOW_UID=1000

# ---------------------------------------------------------------------------
# Superset metadata database (Superset internals only)
# ---------------------------------------------------------------------------
SUPERSET_DB_USER=superset
SUPERSET_DB_PASSWORD=your_superset_db_password
SUPERSET_DB_NAME=superset_db

# ---------------------------------------------------------------------------
# Superset security key
# Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------------
SUPERSET_SECRET_KEY=your_superset_secret_key

# ---------------------------------------------------------------------------
# Superset admin user (created on first init)
# ---------------------------------------------------------------------------
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=your_superset_admin_password
SUPERSET_ADMIN_EMAIL=your_email@example.com

# ---------------------------------------------------------------------------
# DataHub — metadata platform
# UI:  http://192.168.1.93:9002
# GMS: http://192.168.1.93:8090  (REST API — used by ingestion recipes)
#
# Token signing key and salt — required since DataHub CLI 1.5
# Generate with: openssl rand -base64 32
# ---------------------------------------------------------------------------
DATAHUB_TOKEN_SERVICE_SIGNING_KEY=your_datahub_signing_key
DATAHUB_TOKEN_SERVICE_SALT=your_datahub_salt

# ---------------------------------------------------------------------------
# CKAN — open data catalogue
# UI: http://192.168.1.93:5000 — public via https://ckan.deng.ee
# ---------------------------------------------------------------------------
CKAN_DB_PASSWORD=your_ckan_db_password
CKAN_ADMIN_USER=admin
CKAN_ADMIN_PASSWORD=your_ckan_admin_password
CKAN_ADMIN_EMAIL=your_email@example.com
CKAN_SECRET_KEY=your_ckan_secret_key
